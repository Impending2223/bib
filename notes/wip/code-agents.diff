+            body = body if isinstance(body, dict) else {}
+            eid = str(body.get("id") or (body.get("entry") or {}).get("id") or "")
+            if kind in kinds and eid.startswith(f"{lst.key}.") and not eid.startswith(f"{lst.key}.thread."):
+                out.setdefault(eid, kind)
+    return out
+
